# Vercel > Project > Settings > Environment Variables
WEBFLOW_CLIENT_ID=
WEBFLOW_CLIENT_SECRET=
SESSION_SECRET=            # long random string
APP_URL=https://flowdeck.silitlabs.com
CRON_SECRET=               # long random string; cron-job.org calls /cron/checks?key=... every 5 min, /cron/sync every 15 min, /cron/digest daily
RESEND_API_KEY=            # from resend.com, optional until emails are needed
EMAIL_FROM=Flowdeck <alerts@silitlabs.com>
COMPLIMENTARY_EMAILS=      # comma separated Webflow login emails that get the Agency limit free (your own account)
FREE_SITE_LIMIT=           # optional, default 1
# Lemon Squeezy (paid plans). Products/variants named "Solo Monthly", "Solo Yearly", "Studio ...", "Agency ..."
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=  # webhook URL: https://flowdeck.silitlabs.com/billing/webhook
# Upstash Redis (added automatically by the Vercel marketplace integration)
KV_REST_API_URL=
KV_REST_API_TOKEN=
