# Vercel > Project > Settings > Environment Variables
WEBFLOW_CLIENT_ID=
WEBFLOW_CLIENT_SECRET=
SESSION_SECRET=            # long random string
APP_URL=https://flowdeck.silitlabs.com
CRON_SECRET=               # long random string; cron-job.org calls /cron/checks?key=... every 5 min, /cron/sync every 15 min, /cron/digest daily
RESEND_API_KEY=            # from resend.com, optional until emails are needed
EMAIL_FROM=Flowdeck <alerts@silitlabs.com>
COMPLIMENTARY_EMAILS=      # comma separated Webflow login emails that get the Agency limit free (your own account)
FREE_SITE_LIMIT=           # optional, default 1
# Polar (paid plans; used as soon as POLAR_ACCESS_TOKEN is set). Products named "Flowdeck Solo Monthly" ... "Flowdeck Agency Yearly"
POLAR_ACCESS_TOKEN=        # Polar > Settings > Developers > organization access token; scopes: products:read checkouts:write subscriptions:read subscriptions:write customer_sessions:write
POLAR_WEBHOOK_SECRET=      # whsec_... from Polar > Settings > Webhooks; endpoint https://flowdeck.silitlabs.com/billing/webhook, format Raw, subscription.* events
POLAR_API_BASE=            # optional: https://sandbox-api.polar.sh to test with the Polar sandbox (testers only)
BILLING_PROVIDER=          # optional: lemonsqueezy to go back to Lemon Squeezy, polar to force Polar
# Lemon Squeezy (fallback). Products/variants named "Solo Monthly", "Solo Yearly", "Studio ...", "Agency ..."
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=  # webhook URL: https://flowdeck.silitlabs.com/billing/webhook
BILLING_TEST_EMAILS=  # optional, comma separated: only these accounts can buy while the store has test-mode products only
# Upstash Redis (added automatically by the Vercel marketplace integration)
KV_REST_API_URL=
KV_REST_API_TOKEN=
